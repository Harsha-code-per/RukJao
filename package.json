{
  "name": "rukjao",
  "version": "1.0.0",
  "description": "RukJao: pause before you pay. An AI assistant that checks suspicious messages and tells you exactly what to do next.",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build"
  },
  "author": "Harshavardhan K",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fontsource-variable/anek-devanagari": "^5.3.0",
    "@google/genai": "^3.6.1",
    "@hono/node-server": "^2.1.11",
    "firebase-admin": "^14.5.1",
    "hono": "^4.13.21",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
