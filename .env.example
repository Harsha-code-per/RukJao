# Copy to .env, then run: node --env-file=.env dist-server/index.js
# Every value is optional. Without a key the rule engine answers on its own.

# Gemini API key from Google AI Studio. In production it comes from Secret Manager.
GEMINI_API_KEY=
# Models tried in order until one returns a valid answer.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# Checks allowed per client address per minute.
RATE_LIMIT_PER_MINUTE=20
# Results kept in the in-memory LRU cache.
CACHE_SIZE=500
PORT=8080
